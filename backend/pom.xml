<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.beefamily</groupId>
  <artifactId>bee-family-backend</artifactId>
  <version>0.1.0</version>
  <name>bee-family-backend</name>
  <description>Bee Family backend - family photo album single-process service</description>

  <properties>
    <java.version>17</java.version>
    <!-- 强制字节码版本为 17：本机默认 JDK 为 25，禁止产出越界字节码 -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <jjwt.version>0.12.6</jjwt.version>
    <thumbnailator.version>0.4.20</thumbnailator.version>
    <metadata-extractor.version>2.19.0</metadata-extractor.version>
    <lombok.version>1.18.34</lombok.version>
    <!--
      默认排除的测试 Tag。可通过 -Dqa.excludedGroups=none 覆盖（用来显式跑需要真实 MySQL 的用例）。
      做成属性而不是字面量，是因为 Maven 的 -D 无法覆盖 POM 里写死的 plugin 参数。
    -->
    <qa.excludedGroups>mysql</qa.excludedGroups>
  </properties>

  <!--
    HEIC 解码器（docs/07 §9.2 备选 A）：openize:openize-heic 不在 Maven Central，
    由上游 GitHub 锁定 commit 源码自建后 vendor 到项目内 file:// 仓库。
    - 产物与可复现构建记录见 backend/lib/COMMIT.lock；
    - 纯 Java，无 native / JNI / JNA 依赖，无 ProcessBuilder / Runtime.exec / 系统命令；
    - 备选 B（Aspose 私有仓）仅作 spike 对照，未进入本依赖树。
  -->
  <repositories>
    <repository>
      <id>bee-vendor</id>
      <name>Bee Family vendored artifacts</name>
      <url>file://${project.basedir}/lib/maven-repo</url>
      <releases>
        <enabled>true</enabled>
        <updatePolicy>never</updatePolicy>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- Web / MVC -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 安全：Filter 链 + BCrypt -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Bean Validation：前后端同一套阈值的后端权威校验 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- JPA / Hibernate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Flyway 表结构版本化（MySQL 8 支持需 flyway-mysql） -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <!-- 健康检查（仅暴露 /actuator/health） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- MySQL 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- 缩略图生成（纯 Java，无 native 依赖） -->
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>${thumbnailator.version}</version>
    </dependency>
    <!-- EXIF 读取（DateTimeOriginal / GPS）；全局唯一版本 2.19.0 -->
    <dependency>
      <groupId>com.drewnoakes</groupId>
      <artifactId>metadata-extractor</artifactId>
      <version>${metadata-extractor.version}</version>
    </dependency>
    <!--
      纯 Java HEIC 解码（vendored，锁 commit 1118f3c45a47a60cde593a6c47848b2a3a961b9a）。
      上游 POM 声明 metadata-extractor:2.20.0；必须排除，否则与项目锁定的 2.19.0 并存，
      EXIF 解析会出现两个版本。排除后由上面那条 2.19.0 统一提供。
      上游 test scope 的 testng / jacoco 不会传递到本项目。
    -->
    <dependency>
      <groupId>openize</groupId>
      <artifactId>openize-heic</artifactId>
      <version>26.5.1</version>
      <exclusions>
        <exclusion>
          <groupId>com.drewnoakes</groupId>
          <artifactId>metadata-extractor</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Lombok 仅用于实体 getter/setter 消噪；DTO 一律用 record -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>bee-family-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!--
            默认排除 @Tag("mysql") 用例，保证 `mvn test` 在无 MySQL、无任何密钥的机器上也一条命令跑通。
            显式运行方式（需要真实 MySQL）：
              DB_USERNAME=root DB_PASSWORD=root \
              mvn test -Dgroups=mysql -DexcludedGroups= -Dqa.excludedGroups=none
          -->
          <excludedGroups>${qa.excludedGroups}</excludedGroups>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>17</release>
          <encoding>UTF-8</encoding>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
