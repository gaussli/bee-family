# =============================================================================
# 本地开发配置示例 —— 复制为 application-local.yml 后按需修改
#
#   cp backend/src/main/resources/application-local.yml.example \
#      backend/src/main/resources/application-local.yml
#
# ⚠️ application-local.yml 已在 .gitignore 中，含真实口令，**绝不提交**。
# ⚠️ 启动前必须确认 JDK 17：
#      export JAVA_HOME=/Library/Java/JavaVirtualMachines/jdk-17.jdk/Contents/Home
#    启动命令：
#      cd backend && mvn spring-boot:run -Dspring-boot.run.profiles=local
# =============================================================================
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/bee_family?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    # 占位：请替换为你本机 MySQL 的真实口令
    password: CHANGE_ME
  jpa:
    properties:
      hibernate:
        # 本地排查 SQL 时可打开
        format_sql: true
    show-sql: false

app:
  jwt:
    # 开发期可用固定值；任何非本机环境必须替换为随机串（>= 32 字节）
    secret: local-dev-only-secret-please-override-with-32bytes-random
  storage:
    root: ./data/uploads

logging:
  level:
    com.beefamily.album: DEBUG
